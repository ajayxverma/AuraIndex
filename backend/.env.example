# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
DATA_DIR=./data
MAX_UPLOAD_MB=25

# --- ChromaDB ---
# server   = standalone Chroma process on CHROMA_HOST:CHROMA_PORT (run.sh starts/stops it)
# embedded = runs inside the backend process, no separate server
CHROMA_MODE=server
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# --- Embeddings (used to index files and search) ---
# local  = free offline all-MiniLM-L6-v2, no key needed
# openai = any OpenAI-compatible embeddings API (OpenAI, Azure, Ollama, Together, ...)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Example OpenAI: EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_API_KEY=sk-...

# --- Chat LLM (generates answers) ---
# groq   = Groq (base URL preset)
# openai = any OpenAI-compatible chat API (set LLM_BASE_URL for non-OpenAI servers)
LLM_PROVIDER=groq
CHAT_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_...
LLM_BASE_URL=

# --- RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
